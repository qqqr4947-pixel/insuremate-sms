<?xml version="1.0" encoding="utf-8"?>
<!-- 화면 틀 — 본문(ViewPager2) 위에 «떠 있는» 아래 탭바. 폰앱 IMTabBar 와 같은 자리·크기 (im8 · 2026-09-06) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/im_bg"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- im11 · 설정 안쪽 화면 머리줄 «← 화면 이름» — 안쪽에 들어갔을 때만 보인다(박 대표 2026-09-24 「뒤로가는 버튼이 없다」) -->
        <LinearLayout
            android:id="@+id/backBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/im_appbar"
            android:background="@color/im_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="@dimen/im_page"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/im_back"
                android:scaleType="center"
                android:src="@drawable/ic_im_back"
                app:tint="@color/im_ink" />

            <TextView
                android:id="@+id/backTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/im_ink"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="내 서버" />
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/progressBarOverlay"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />
    </FrameLayout>

    <!-- 아래 탭바: 바닥 14 띄운 알약(높이 66 · 라운딩 38 · 흰 바탕 + 그림자). 선택 탭만 파란 네모 안 흰 아이콘 -->
    <FrameLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/im_tabbar_h"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/im_tabbar_margin"
        android:background="@drawable/im_tabbar_bg"
        android:elevation="8dp"
        android:outlineProvider="background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/im_tabbar_pad">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/tabHome"
                    android:layout_width="@dimen/im_tab_item"
                    android:layout_height="@dimen/im_tab_item"
                    android:layout_gravity="center"
                    android:background="@drawable/im_tab_item_bg"
                    android:contentDescription="@string/tab_text_home"
                    android:scaleType="center"
                    android:src="@drawable/ic_home"
                    app:tint="@color/im_tab_icon_sel" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/tabMessages"
                    android:layout_width="@dimen/im_tab_item"
                    android:layout_height="@dimen/im_tab_item"
                    android:layout_gravity="center"
                    android:background="@drawable/im_tab_item_bg"
                    android:contentDescription="@string/tab_text_messages"
                    android:scaleType="center"
                    android:src="@drawable/ic_sms"
                    app:tint="@color/im_tab_icon_sel" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/tabSettings"
                    android:layout_width="@dimen/im_tab_item"
                    android:layout_height="@dimen/im_tab_item"
                    android:layout_gravity="center"
                    android:background="@drawable/im_tab_item_bg"
                    android:contentDescription="@string/tab_text_settings"
                    android:scaleType="center"
                    android:src="@drawable/ic_advanced"
                    app:tint="@color/im_tab_icon_sel" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
