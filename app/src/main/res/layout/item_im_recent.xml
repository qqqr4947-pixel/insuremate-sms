<?xml version="1.0" encoding="utf-8"?>
<!-- 최근 보낸 문자 한 줄 (키트 .tui-row · 최소 높이 52) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/im_row_min"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textRecentPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lines="1"
            android:textColor="@color/im_ink"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="010-XXXX-XXXX" />

        <TextView
            android:id="@+id/textRecentTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:lines="1"
            android:textColor="@color/im_sub"
            android:textSize="13sp"
            tools:text="09:12" />
    </LinearLayout>

    <TextView
        android:id="@+id/chipRecentState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_im_chip"
        android:backgroundTint="@color/im_ok_bg"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:textColor="@color/im_ok_fg"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="도착" />
</LinearLayout>
