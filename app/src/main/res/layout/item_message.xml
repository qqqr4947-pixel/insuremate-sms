<?xml version="1.0" encoding="utf-8"?>
<!-- 문자 한 줄 — 인슈어 UI (2026-09-06)
     바뀐 것: 「표 번호(UUID)·영어 상태」 → «보낸 내용 · 시각 · 한국어 상태 칩».
     사람은 자기가 보낸 문자를 «번호»로 기억하지 않는다. 번호는 자세히 화면에 남아 있다.
     🔴 id 는 그대로 둔다(다른 화면이 쓴다) — 이 줄에서 «보여주지» 않을 뿐이다. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:minHeight="@dimen/im_row_min"
    android:paddingStart="@dimen/im_card_pad"
    android:paddingEnd="@dimen/im_card_pad"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- 상태 색 점 — 글자를 읽기 전에 «됐나/안 됐나»가 먼저 보이게 -->
    <ImageView
        android:id="@+id/imageViewState"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_sms"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 보낸 내용 — 이 줄이 무엇인지 알려주는 유일한 글자다 -->
    <TextView
        android:id="@+id/textViewId"
        style="@style/Im.RowKey"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/textViewState"
        app:layout_constraintStart_toEndOf="@id/imageViewState"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="김영수 고객님, 안녕하세요. 한화생명 박장오 팀장입니다." />

    <!-- 언제 -->
    <TextView
        android:id="@+id/textViewDate"
        style="@style/Im.RowSub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toStartOf="@+id/textViewState"
        app:layout_constraintStart_toEndOf="@id/imageViewState"
        app:layout_constraintTop_toBottomOf="@id/textViewId"
        tools:text="오늘 09:12" />

    <!-- 상태 칩 — 한국어로 -->
    <TextView
        android:id="@+id/textViewState"
        style="@style/Im.Chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_im_chip"
        android:textColor="@color/im_hold_fg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="도착" />

</androidx.constraintlayout.widget.ConstraintLayout>
