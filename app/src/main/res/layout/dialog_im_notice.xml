<?xml version="1.0" encoding="utf-8"?>
<!-- 11-12 박 대표 «팝업창 뜨는거 깔끔하게» — 연결 실패 안내 창. 홈 카드와 같은 부품(흰 면 20 라운딩 · 아이콘 칩 · 파란 큰 단추) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_im_card"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <ImageView
        android:id="@+id/iconNotice"
        android:layout_width="@dimen/im_icon_chip"
        android:layout_height="@dimen/im_icon_chip"
        android:background="@drawable/bg_im_icon"
        android:backgroundTint="@color/im_warn_bg"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_im_phone"
        app:tint="@color/im_warn_fg" />

    <TextView
        android:id="@+id/textNoticeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/im_ink"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="폰을 연결하지 못했어요" />

    <!-- 번호 다름일 때만: 이 폰 ••••5678 ≠ 인슈어메이트 ••••1234 -->
    <LinearLayout
        android:id="@+id/layoutNoticeNums"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/textNoticePhone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_im_field"
            android:gravity="center"
            android:padding="10dp"
            android:textColor="@color/im_ink"
            android:textSize="16sp"
            tools:text="이 폰\n••••5678" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:text="≠"
            android:textColor="@color/im_danger_fg"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textNoticeAccount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_im_field"
            android:gravity="center"
            android:padding="10dp"
            android:textColor="@color/im_ink"
            android:textSize="16sp"
            tools:text="인슈어메이트\n••••1234" />
    </LinearLayout>

    <TextView
        android:id="@+id/textNoticeBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/im_sub"
        android:textSize="16sp"
        tools:text="이 폰의 유심 번호를 읽지 못했어요. 유심이 꽂혀 있는지 확인한 뒤 다시 연결해 주세요" />

    <!-- im16 · 설정 화면에서 무엇을 켜는지 실제 화면 그림(있을 때만) -->
    <ImageView
        android:id="@+id/imageNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:adjustViewBounds="true"
        android:background="@drawable/bg_im_field"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonNoticeOk"
        android:layout_width="match_parent"
        android:layout_height="@dimen/im_btn_h"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/im_blue"
        android:letterSpacing="0"
        android:text="@string/im_notice_ok"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="@dimen/im_btn_r"
        app:elevation="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonNoticeSecond"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:letterSpacing="0"
        android:text="@string/im_notice_close"
        android:textAllCaps="false"
        android:textColor="@color/im_sub"
        android:textSize="15sp" />
</LinearLayout>
