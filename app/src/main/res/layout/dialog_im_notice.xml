<?xml version="1.0" encoding="utf-8"?>
<!-- 11-12 박 대표 «팝업창 뜨는거 깔끔하게» — 연결 실패 안내 창. 홈 카드와 같은 부품(흰 면 20 라운딩 · 아이콘 칩 · 파란 큰 단추) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_im_card"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <ImageView
        android:layout_width="@dimen/im_icon_chip"
        android:layout_height="@dimen/im_icon_chip"
        android:background="@drawable/bg_im_icon"
        android:backgroundTint="@color/im_warn_bg"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_im_phone"
        app:tint="@color/im_warn_fg" />

    <TextView
        android:id="@+id/textNoticeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/im_ink"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="폰을 연결하지 못했어요" />

    <TextView
        android:id="@+id/textNoticeBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/im_sub"
        android:textSize="16sp"
        tools:text="이 폰의 유심 번호를 읽지 못했어요. 유심이 꽂혀 있는지 확인한 뒤 다시 연결해 주세요" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonNoticeOk"
        android:layout_width="match_parent"
        android:layout_height="@dimen/im_btn_h"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/im_blue"
        android:letterSpacing="0"
        android:text="@string/im_notice_ok"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="@dimen/im_btn_r"
        app:elevation="0dp" />
</LinearLayout>
