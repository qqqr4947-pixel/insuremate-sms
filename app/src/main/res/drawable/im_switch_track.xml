<?xml version="1.0" encoding="utf-8"?>
<!-- 스위치 바탕 — 시안 실측 46×27 · 라운딩 999 · 켜짐 파랑 / 꺼짐 tui-press -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/im_blue" />
            <corners android:radius="999dp" />
            <size android:width="@dimen/im_switch_w" android:height="@dimen/im_switch_h" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/im_press" />
            <corners android:radius="999dp" />
            <size android:width="@dimen/im_switch_w" android:height="@dimen/im_switch_h" />
        </shape>
    </item>
</selector>
